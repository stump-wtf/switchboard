{
  "name": "switchboard-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for switchboard (ADRs + specs), themed for the switchboard era.",
  "scripts": {
    "build-content": "node scripts/build-docs.mjs && npm run gen-api",
    "gen-api": "node scripts/api-docs.mjs pre && docusaurus gen-api-docs switchboard --plugin-id openapi && node scripts/api-docs.mjs post",
    "prestart": "npm run build-content",
    "start": "docusaurus start",
    "prebuild": "npm run build-content",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "^5.1.2",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "^5.1.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.102.0"
  },
  "overrides": {
    "webpack": "5.105.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
