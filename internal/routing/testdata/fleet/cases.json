[
  {"name": "gitea: trusted unsized issue opened goes to triage", "sample": "gitea-issue-opened",
   "want": {"queue": "triage", "rule": "unsized-new-issue"}},
  {"name": "gitea: issue opened already sized S goes to the local lane", "sample": "gitea-issue-opened",
   "patch": {"issue": {"labels": [{"id": 567, "name": "size/S"}]}},
   "want": {"queue": "lane-local", "rule": "size-s"}},
  {"name": "gitea: triage sizes it M, and that label event routes to zai-flash", "sample": "gitea-issue-label-updated",
   "want": {"queue": "lane-zai-flash", "rule": "size-m"}},
  {"name": "gitea: size/L goes to zai", "sample": "gitea-issue-label-updated",
   "patch": {"issue": {"labels": [{"id": 569, "name": "size/L"}]}},
   "want": {"queue": "lane-zai", "rule": "size-l"}},
  {"name": "gitea: size/XL is held for Joe", "sample": "gitea-issue-label-updated",
   "patch": {"issue": {"labels": [{"id": 570, "name": "size/XL"}]}},
   "want": {"queue": "hold", "rule": "size-xl"}},
  {"name": "gitea: a HUMAN verdict is held even when sized", "sample": "gitea-issue-label-updated",
   "patch": {"issue": {"labels": [{"id": 568, "name": "size/M"}, {"id": 900, "name": "HUMAN"}]}},
   "want": {"queue": "hold", "rule": "human-verdict"}},
  {"name": "gitea: two size labels are held, not guessed", "sample": "gitea-issue-label-updated",
   "patch": {"issue": {"labels": [{"id": 567, "name": "size/S"}, {"id": 569, "name": "size/L"}]}},
   "want": {"queue": "hold", "rule": "ambiguous-size"}},
  {"name": "gitea: a non-size label on an unsized issue never loops back to triage", "sample": "gitea-issue-label-updated",
   "patch": {"issue": {"labels": [{"id": 157, "name": "bug"}]}},
   "want": {"drop": true}},
  {"name": "gitea: an untrusted author is dropped", "sample": "gitea-issue-opened",
   "patch": {"issue": {"user": {"login": "stranger"}}, "sender": {"login": "stranger"}},
   "want": {"drop": true, "rule": "untrusted-author"}},
  {"name": "gitea: a stranger labeling a trusted issue is dropped", "sample": "gitea-issue-label-updated",
   "patch": {"sender": {"login": "stranger"}},
   "want": {"drop": true, "rule": "untrusted-labeler"}},
  {"name": "gitea: Renovate's Dependency Dashboard is dropped", "sample": "gitea-issue-opened",
   "patch": {"issue": {"title": "Dependency Dashboard", "user": {"login": "renovate-bot"}}},
   "want": {"drop": true, "rule": "bot-issue"}},
  {"name": "gitea: the BOT verdict is dropped", "sample": "gitea-issue-label-updated",
   "patch": {"issue": {"labels": [{"id": 901, "name": "BOT"}]}},
   "want": {"drop": true, "rule": "bot-issue"}},
  {"name": "gitea: a repo outside the allowlist is dropped", "sample": "gitea-issue-opened",
   "patch": {"repository": {"full_name": "someone/else"}},
   "want": {"drop": true, "rule": "repo-not-allowlisted"}},
  {"name": "gitea: a closed issue is dropped", "sample": "gitea-issue-label-updated",
   "patch": {"issue": {"state": "closed"}},
   "want": {"drop": true, "rule": "not-open"}},
  {"name": "gitea: an edit is not a routing event", "sample": "gitea-issue-opened",
   "patch": {"action": "edited"},
   "want": {"drop": true, "rule": "not-routable-action"}},
  {"name": "gitea: pull request label events are not issues", "sample": "gitea-pull-request-label",
   "want": {"drop": true, "rule": "not-an-issue"}},
  {"name": "gitea: an unverified token delivery is never work", "sample": "gitea-issue-opened",
   "verified": false, "trust_mode": "token",
   "want": {"drop": true, "rule": "unverified"}},
  {"name": "github: trusted unsized issue opened goes to triage", "sample": "github-issues-opened",
   "want": {"queue": "triage", "rule": "unsized-new-issue"}},
  {"name": "github: labeled size/S goes to the local lane", "sample": "github-issues-labeled",
   "want": {"queue": "lane-local", "rule": "size-s"}},
  {"name": "github: unlabeled is not a routing event", "sample": "github-issues-labeled",
