  {"name": "cairn: vision lane", "sample": "cairn-artifact-created",
   "patch": {"data": {"labels": {"lane": "vision"}}},
   "want": {"queue": "lane-vision", "rule": "cairn-lane-vision"}},
  {"name": "cairn: hyper lane", "sample": "cairn-artifact-created",
   "patch": {"data": {"labels": {"lane": "hyper"}}},
   "want": {"queue": "lane-hyper", "rule": "cairn-lane-hyper"}},
  {"name": "cairn: local lane", "sample": "cairn-artifact-created",
   "patch": {"data": {"labels": {"lane": "local"}}},
   "want": {"queue": "lane-local", "rule": "cairn-lane-local"}},
  {"name": "cairn: unsized, unpinned handoff goes to triage", "sample": "cairn-artifact-created",
   "patch": {"data": {"labels": {"lane": "auto", "size": ""}}},
   "want": {"queue": "triage", "rule": "cairn-triage"}},
  {"name": "cairn: an XL handoff is held even when pinned", "sample": "cairn-artifact-created",
   "patch": {"data": {"labels": {"size": "XL"}}},
   "want": {"queue": "hold", "rule": "cairn-size-xl"}},
  {"name": "cairn: a handoff from an actor outside the allowlist is dropped", "sample": "cairn-artifact-created",
   "patch": {"data": {"actor_id": "someone-else"}},
   "want": {"drop": true, "rule": "cairn-untrusted-actor"}},
  {"name": "cairn: labels cannot talk an untrusted actor past the allowlist", "sample": "cairn-artifact-created",
   "patch": {"data": {"actor_id": "someone-else", "labels": {"handoff": "true", "trusted": "true", "lane": "local"}}},
   "want": {"drop": true, "rule": "cairn-untrusted-actor"}},
  {"name": "cairn: a handoff on behalf of a stranger is held", "sample": "cairn-artifact-created",
   "patch": {"data": {"on_behalf_of": "stranger"}},
   "want": {"queue": "hold", "rule": "cairn-on-behalf-untrusted"}},
  {"name": "cairn: a paste that is not a handoff is dropped", "sample": "cairn-artifact-created",
   "patch": {"data": {"labels": {"handoff": "false"}}},
   "want": {"drop": true, "rule": "cairn-not-handoff"}},
  {"name": "cairn: a bundle handoff routes like a single artifact", "sample": "cairn-artifact-created",
   "patch": {"data": {"share_type": "bundle"}},
   "want": {"queue": "lane-zai-flash", "rule": "cairn-lane-zai-flash"}},
  {"name": "cairn: an unverified delivery is never work", "sample": "cairn-artifact-created",
   "verified": false,
   "want": {"drop": true, "rule": "unverified"}}
]
