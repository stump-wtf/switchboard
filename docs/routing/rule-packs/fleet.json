{
  "params": {
    "require_verified": true,
    "trusted_humans": ["joestump"],
    "trusted_agents": ["joestump-agent"],
    "cairn_actors": ["joestump-agent", "joestump"],
    "repo_prefixes": ["stump.wtf/", "stumpcloud/", "joestump/", "joestump-agent/"]
  },
  "rules": [
    {
      "id": "unverified",
      "name": "unverified deliveries are never work orders",
      "expr": "($params.require_verified != false) and (.verified | not)",
      "action": {"drop": true}
    },
    {
      "id": "cairn-not-handoff",
      "name": "cairn artifacts without the handoff tag",
      "expr": ".source == \"cairn\" and (any((.artifact.tags // [])[]; . == \"handoff\") | not)",
      "action": {"drop": true}
    },
    {
      "id": "cairn-untrusted-actor",
      "name": "cairn handoffs from actors outside cairn_actors",
      "expr": ".source == \"cairn\" and ((.artifact.actor_id // \"\") as $a | any(($params.cairn_actors // [])[]; . == $a) | not)",
      "action": {"drop": true}
    },
    {
      "id": "cairn-ambiguous",
      "name": "more than one lane: or size: tag is held, not guessed",
      "expr": ".source == \"cairn\" and (([(.artifact.tags // [])[] | select(startswith(\"lane:\"))] | length > 1) or ([(.artifact.tags // [])[] | select(startswith(\"size:\"))] | length > 1))",
      "action": {"queue": "hold", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-size-xl",
      "name": "size:xl handoffs are held for Joe",
      "expr": ".source == \"cairn\" and any((.artifact.tags // [])[]; . == \"size:xl\")",
      "action": {"queue": "hold", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-lane-s",
      "name": "handoff pinned to lane:s",
      "expr": ".source == \"cairn\" and any((.artifact.tags // [])[]; . == \"lane:s\")",
      "action": {"queue": "lane-s", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-lane-m",
      "name": "handoff pinned to lane:m",
      "expr": ".source == \"cairn\" and any((.artifact.tags // [])[]; . == \"lane:m\")",
      "action": {"queue": "lane-m", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-lane-l",
      "name": "handoff pinned to lane:l",
      "expr": ".source == \"cairn\" and any((.artifact.tags // [])[]; . == \"lane:l\")",
      "action": {"queue": "lane-l", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-lane-vision",
      "name": "handoff pinned to lane:vision",
      "expr": ".source == \"cairn\" and any((.artifact.tags // [])[]; . == \"lane:vision\")",
      "action": {"queue": "lane-vision", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-size-s",
      "name": "lane:auto or unpinned size:s handoff",
      "expr": ".source == \"cairn\" and any((.artifact.tags // [])[]; . == \"size:s\")",
      "action": {"queue": "lane-s", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-size-m",
      "name": "lane:auto or unpinned size:m handoff",
      "expr": ".source == \"cairn\" and any((.artifact.tags // [])[]; . == \"size:m\")",
      "action": {"queue": "lane-m", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-size-l",
      "name": "lane:auto or unpinned size:l handoff",
      "expr": ".source == \"cairn\" and any((.artifact.tags // [])[]; . == \"size:l\")",
      "action": {"queue": "lane-l", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "cairn-triage",
      "name": "unsized, unpinned handoff to triage",
      "expr": ".source == \"cairn\"",
      "action": {"queue": "triage", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "not-an-issue",
      "name": "everything that is not an issue event",
      "expr": ".issue == null",
      "action": {"drop": true}
    },
    {
      "id": "repo-not-allowlisted",
      "name": "issues outside repo_prefixes",
      "expr": ".issue.repo as $r | any(($params.repo_prefixes // [])[]; . as $p | $r | startswith($p)) | not",
      "action": {"drop": true}
    },
    {
      "id": "bot-issue",
      "name": "Renovate dashboards, bot authors, and the BOT verdict",
      "expr": "(.issue.author | test(\"renovate\"; \"i\") or endswith(\"[bot]\")) or (.issue.title | test(\"^dependency dashboard$\"; \"i\")) or any(.issue.labels[]; . == \"BOT\")",
      "action": {"drop": true}
    },
    {
      "id": "untrusted-author",
      "name": "issues written by anyone outside the trusted humans and agents",
      "expr": ".issue.author as $a | any(((($params.trusted_humans // []) | arrays) + (($params.trusted_agents // []) | arrays))[]; . == $a) | not",
      "action": {"drop": true}
    },
    {
      "id": "untrusted-labeler",
      "name": "label changes made by anyone outside the trusted humans and agents",
      "expr": ".issue.label_event and (.issue.sender as $s | any(((($params.trusted_humans // []) | arrays) + (($params.trusted_agents // []) | arrays))[]; . == $s) | not)",
      "action": {"drop": true}
    },
    {
      "id": "not-open",
      "name": "closed issues",
      "expr": ".issue.state != \"open\"",
      "action": {"drop": true}
    },
    {
      "id": "not-routable-action",
      "name": "only opened, reopened, and label events route",
      "expr": ".issue.action | IN(\"opened\", \"reopened\", \"labeled\", \"label_updated\") | not",
      "action": {"drop": true}
    },
    {
      "id": "human-verdict",
      "name": "HUMAN verdict is held for Joe",
      "expr": "any(.issue.labels[]; . == \"HUMAN\")",
      "action": {"queue": "hold", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "size-xl",
      "name": "size/XL is held for Joe",
      "expr": "any(.issue.labels[]; . == \"size/XL\")",
      "action": {"queue": "hold", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "ambiguous-size",
      "name": "more than one size label is held, not guessed",
      "expr": "[.issue.labels[] | select(startswith(\"size/\"))] | length > 1",
      "action": {"queue": "hold", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "size-s",
      "name": "size/S to lane-s",
      "expr": "any(.issue.labels[]; . == \"size/S\")",
      "action": {"queue": "lane-s", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "size-m",
      "name": "size/M to lane-m",
      "expr": "any(.issue.labels[]; . == \"size/M\")",
      "action": {"queue": "lane-m", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "size-l",
      "name": "size/L to lane-l",
      "expr": "any(.issue.labels[]; . == \"size/L\")",
      "action": {"queue": "lane-l", "exclusive": true, "once": true, "work_order": true}
    },
    {
      "id": "unsized-new-issue",
      "name": "a new or reopened unsized issue goes to triage to be sized",
      "expr": ".issue.action | IN(\"opened\", \"reopened\")",
      "action": {"queue": "triage", "exclusive": true, "once": true, "work_order": true}
    }
  ],
  "default_action": {"drop": true}
}
